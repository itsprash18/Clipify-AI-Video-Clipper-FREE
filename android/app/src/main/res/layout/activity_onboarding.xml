<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clipify_bg"
    android:padding="24dp">

    <!-- Step Progress Header -->
    <TextView
        android:id="@+id/step_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Step 1 of 7"
        android:textColor="@color/clipify_muted"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:progress="14"
        android:progressTint="@color/clipify_brand"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/step_indicator" />

    <!-- Container for the 7 Onboarding Screens -->
    <FrameLayout
        android:id="@+id/screen_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginVertical="24dp"
        app:layout_constraintTop_toBottomOf="@id/progress_bar"
        app:layout_constraintBottom_toTopOf="@id/button_bar">

        <!-- SCREEN 1: WELCOME -->
        <LinearLayout
            android:id="@+id/step1_welcome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_clipify_logo"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_welcome_title"
                android:textColor="@color/clipify_text"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_welcome_desc"
                android:textColor="@color/clipify_muted"
                android:textSize="14sp"
                android:gravity="center"
                android:paddingHorizontal="16dp" />
        </LinearLayout>

        <!-- SCREEN 2: DEVICE COMPATIBILITY -->
        <LinearLayout
            android:id="@+id/step2_compat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_compat_title"
                android:textColor="@color/clipify_text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_compat_desc"
                android:textColor="@color/clipify_muted"
                android:textSize="13sp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:id="@+id/tv_compat_os"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/clipify_text"
                android:padding="12dp"
                android:background="@color/clipify_panel"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_compat_arch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/clipify_text"
                android:padding="12dp"
                android:background="@color/clipify_panel"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_compat_ram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/clipify_text"
                android:padding="12dp"
                android:background="@color/clipify_panel" />
        </LinearLayout>

        <!-- SCREEN 3: PERMISSIONS -->
        <LinearLayout
            android:id="@+id/step3_perms"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_perm_title"
                android:textColor="@color/clipify_text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_perm_desc"
                android:textColor="@color/clipify_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- SCREEN 4: AI CONFIGURATION -->
        <LinearLayout
            android:id="@+id/step4_ai"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_ai_title"
                android:textColor="@color/clipify_text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rg_ai_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rb_option_lan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_option_lan"
                    android:textColor="@color/clipify_text"
                    android:checked="true"
                    android:layout_marginBottom="8dp" />

                <RadioButton
                    android:id="@+id/rb_option_remote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_option_remote"
                    android:textColor="@color/clipify_text"
                    android:layout_marginBottom="8dp" />

                <RadioButton
                    android:id="@+id/rb_option_local"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_option_local"
                    android:textColor="@color/clipify_text" />
            </RadioGroup>
        </LinearLayout>

        <!-- SCREEN 5: VIDEO PROCESSING SETUP -->
        <LinearLayout
            android:id="@+id/step5_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_video_title"
                android:textColor="@color/clipify_text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_video_desc"
                android:textColor="@color/clipify_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- SCREEN 6: STORAGE SETUP -->
        <LinearLayout
            android:id="@+id/step6_storage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_storage_title"
                android:textColor="@color/clipify_text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_storage_free"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/clipify_text"
                android:padding="16dp"
                android:background="@color/clipify_panel" />
        </LinearLayout>

        <!-- SCREEN 7: COMPLETION -->
        <LinearLayout
            android:id="@+id/step7_complete"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎉"
                android:textSize="48sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_done_title"
                android:textColor="@color/clipify_text"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_done_desc"
                android:textColor="@color/clipify_muted"
                android:textSize="14sp"
                android:gravity="center"
                android:paddingHorizontal="24dp" />
        </LinearLayout>

    </FrameLayout>

    <!-- Navigation Action Bar -->
    <LinearLayout
        android:id="@+id/button_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Back"
            android:textColor="@color/clipify_text"
            android:backgroundTint="@color/clipify_panel"
            android:layout_marginEnd="12dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_next"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="2"
            android:text="Next"
            android:textColor="@color/clipify_text_inverted"
            android:backgroundTint="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
