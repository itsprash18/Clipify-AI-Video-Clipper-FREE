{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "Clipify AI Design System Tokens",
  "version": "1.0.0",
  "description": "Universal design tokens shared across Windows, Linux, macOS, and Android",
  "tokens": {
    "colors": {
      "background": {
        "primary": "#09090b",
        "secondary": "#121215",
        "surface": "rgba(18, 18, 21, 0.94)",
        "surfaceStrong": "rgba(24, 24, 27, 0.98)",
        "elevated": "rgba(30, 30, 36, 0.95)",
        "card": "#18181b",
        "cardHover": "#222226"
      },
      "border": {
        "subtle": "#27272a",
        "strong": "#3f3f46",
        "focus": "rgba(255, 255, 255, 0.35)",
        "accent": "#6366f1"
      },
      "text": {
        "primary": "#fafafa",
        "secondary": "#a1a1aa",
        "tertiary": "#71717a",
        "inverted": "#09090b",
        "warm": "#ffffff",
        "warmMuted": "#e4e4e7"
      },
      "accent": {
        "primary": "#ffffff",
        "brand": "#6366f1",
        "brandHover": "#4f46e5",
        "brandGlow": "rgba(99, 102, 241, 0.35)",
        "cyan": "#06b6d4",
        "purple": "#a855f7"
      },
      "status": {
        "success": "#10b981",
        "successBg": "rgba(16, 185, 129, 0.12)",
        "warning": "#f59e0b",
        "warningBg": "rgba(245, 158, 11, 0.12)",
        "error": "#ef4444",
        "errorBg": "rgba(239, 68, 68, 0.15)",
        "info": "#3b82f6",
        "infoBg": "rgba(59, 130, 246, 0.12)"
      },
      "captions": {
        "yellow": "#eab308",
        "coral": "#f43f5e",
        "cyan": "#06b6d4",
        "green": "#22c55e",
        "white": "#ffffff"
      }
    },
    "typography": {
      "fontFamily": {
        "sans": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
        "display": "'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif",
        "mono": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace"
      },
      "fontSize": {
        "xs": "11px",
        "sm": "12px",
        "base": "14px",
        "md": "15px",
        "lg": "18px",
        "xl": "22px",
        "2xl": "28px",
        "3xl": "36px"
      },
      "fontWeight": {
        "regular": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700,
        "extrabold": 800,
        "black": 900
      },
      "lineHeight": {
        "tight": 1.15,
        "snug": 1.3,
        "normal": 1.5,
        "relaxed": 1.7
      },
      "letterSpacing": {
        "tight": "-0.02em",
        "normal": "-0.015em",
        "wide": "0.04em",
        "wider": "0.08em"
      }
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px"
    },
    "borderRadius": {
      "sm": "6px",
      "md": "8px",
      "lg": "12px",
      "xl": "16px",
      "2xl": "24px",
      "pill": "9999px"
    },
    "shadows": {
      "sm": "0 1px 3px rgba(0, 0, 0, 0.4)",
      "md": "0 4px 14px rgba(0, 0, 0, 0.5)",
      "lg": "0 12px 32px rgba(0, 0, 0, 0.65)",
      "xl": "0 20px 60px rgba(0, 0, 0, 0.75)",
      "glow": "0 0 20px rgba(99, 102, 241, 0.35)",
      "glowGreen": "0 0 16px rgba(16, 185, 129, 0.4)"
    },
    "transitions": {
      "fast": "150ms cubic-bezier(0.16, 1, 0.3, 1)",
      "normal": "220ms cubic-bezier(0.16, 1, 0.3, 1)",
      "slow": "350ms cubic-bezier(0.16, 1, 0.3, 1)"
    },
    "zIndex": {
      "base": 0,
      "panel": 5,
      "sidebar": 10,
      "header": 15,
      "dropdown": 20,
      "modal": 50,
      "toast": 100
    },
    "breakpoints": {
      "mobile": "480px",
      "tablet": "768px",
      "laptop": "1024px",
      "desktop": "1280px"
    }
  }
}
